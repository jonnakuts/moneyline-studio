{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "react"
    ],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "engine/**/*.ts",
    "engine/**/*.tsx",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ]
}
