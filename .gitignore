models/
tools/audio/models/
*.onnx
*.bin
*.pt
*.safetensors

# Media and renders (large; keep JSON/MD only in git)
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.flac
*.png
*.jpg
*.jpeg
*.webp
!assets/**/*.svg
out/
renders/
videos/**/renders/
videos/**/frames/
videos/**/footage/
videos/**/audio/

