{
  "name": "moneyline-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Zero-cost, gated pipeline for code-rendered Money & Business explainer videos.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "new": "tsx tools/video/new-video.ts",
    "verify": "tsx tools/verify/cli.ts verify",
