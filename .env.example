# Copy this file to .env and fill in your own values.
# .env is git-ignored. NEVER commit real keys — this repo is public.

# --- LLM for research help and script drafting (free) ---
# Get a key at https://build.nvidia.com (Settings → API Keys). OpenAI-compatible endpoint.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Pick a model from build.nvidia.com/models and put its ID here.
NVIDIA_MODEL=

# --- Data sources ---
# SEC EDGAR needs no key, but requires a descriptive User-Agent with contact info.
# Format: "Your Name your-email@example.com"
SEC_USER_AGENT=
# FRED (US Federal Reserve data): free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# World Bank, IMF, OECD, Our World in Data: no key needed.

# --- Footage / photos (free developer keys) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Local tool paths (Windows examples; leave blank if on PATH) ---
FFMPEG_PATH=
RHUBARB_PATH=
PYTHON_PATH=

# --- Render settings for this machine (i3, 8 GB RAM) ---
REMOTION_CONCURRENCY=2
PREVIEW_WIDTH=960
PREVIEW_HEIGHT=540
